# Copy to .env and fill in real values. .env is gitignored.

# Tailscale auth key for the sidecar's own node identity.
# Generate at https://login.tailscale.com/admin/settings/keys (reusable key
# recommended, since this same key can register additional sidecars later).
TS_AUTHKEY=

# LM Studio's local server API key (LM Studio -> Developer tab -> Local
# Server -> API Key) for the remote host reachable over Tailscale.
MACBOOK_PRO_LMSTUDIO_KEY=

# LiteLLM proxy master key (client auth) and salt key (encrypts DB-stored
# model credentials). Set both to long random values before any real use.
# WARNING: once real credentials/models exist, changing LITELLM_SALT_KEY
# makes them undecryptable -- generate it once and keep it stable.
LITELLM_MASTER_KEY=
LITELLM_SALT_KEY=
